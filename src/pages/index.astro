---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';

/* Brands the work has shipped for. The marquee renders this list twice so it
   can loop seamlessly; the second pass is hidden from assistive tech.
   `h` is the rendered height in px, set per logo rather than shared: these
   range from a 0.46 aspect vertical crest (France Judo) to a 12.5 aspect
   wordmark (ItaliaRail), so one height would make the tall ones tiny. Taller
   for crests and stacked lockups, shorter for long wordmarks. */
const brands = [
  { src: '/images/logos/chanel.svg', name: 'CHANEL', h: 39 },
  { src: '/images/logos/att.svg', name: 'AT&T', h: 33, dim: 0.5 },
  { src: '/images/logos/carrefour.svg', name: 'Carrefour', h: 44 },
  { src: '/images/logos/fnac.svg', name: 'Fnac', h: 48, dim: 0.42 },
  { src: '/images/logos/wiggli.svg', name: 'Wiggli', h: 24 },
  { src: '/images/logos/gentis.svg', name: 'Gentis', h: 23, dim: 0.32 },
  { src: '/images/logos/italiarail.svg', name: 'ItaliaRail', h: 16 },
  { src: '/images/logos/european-judo-union.svg', name: 'European Judo Union', h: 20, dim: 0.33 },
  { src: '/images/logos/france-judo.png', name: 'France Judo', h: 56 },
  { src: '/images/logos/fff.png', name: 'Fédération Française de Football', h: 54, dim: 0.28 },
  { src: '/images/logos/ffa-athle.svg', name: "Fédération Française d'Athlétisme", h: 29 },
  { src: '/images/logos/ippon.svg', name: 'Ippon', h: 21 },
];
---

<Layout title="Oussama Bougnouch | Sr UX Designer, AI System Builder"
        description="Principal UX Designer & Product Architect with 13+ years. Reduced candidate dropout 70%, scaled marketplace 9x. CHANEL, AT&T, Fnac, HelloFresh.">

  <Header />

  <PageHeader title="Hi, I'm Oussama!">
    <p class="page-lede">
      I'm a Sr UX Designer, AI System Builder specializing in user-centered design and
      data-driven growth — mapping user journeys, running A/B tests, and shipping interfaces that
      move <a href="#work">business goals</a>, not just pixels.
    </p>
    <div class="logo-marquee">
      <div class="logo-track">
        <ul class="logo-group">
          {brands.map((brand) => (
            <li style={`--logo-h:${brand.h}px;--logo-dim:${brand.dim ?? 0.55}`}><img src={brand.src} alt={brand.name} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
        <ul class="logo-group" aria-hidden="true">
          {brands.map((brand) => (
            <li style={`--logo-h:${brand.h}px;--logo-dim:${brand.dim ?? 0.55}`}><img src={brand.src} alt="" loading="lazy" decoding="async" /></li>
          ))}
        </ul>
      </div>
    </div>

    <img
      slot="media"
      src="/images/intro-illustration.webp"
      alt="Ink illustration of a man in a black suit sitting on a stool, holding a single green apple in both hands"
      width="900"
      height="1106"
      fetchpriority="high"
      decoding="async"
    />
  </PageHeader>

  <!-- WORK -->
  <section id="work" class="work-section">
    <div class="folio-container">
      <header class="section-head">
        <h2>Case studies</h2>
        <p class="section-lede">Long-form breakdowns of the problems I was handed and what shipped.</p>
      </header>

      <div class="media-list">
        <a class="media-row" href="/wiggli-calendar-ux-case-study/">
          <div class="media-row-media">
            <img src="/images/wiggli.png" alt="Wiggli Recruiting Calendar case study" />
            <span class="media-badge">Case study</span>
          </div>
          <div class="media-row-body">
            <h3>Wiggli Recruiting Calendar</h3>
            <p class="media-desc">
              I designed the Wiggli Calendar to eliminate scheduling inefficiencies, reducing candidate
              dropout from 40% to 12% and cutting scheduling time from 3 days to 15 minutes.
            </p>
            <div class="media-chips">
              <span class="chip">Dropout 40% → 12%</span>
              <span class="chip">3 days → 15 min</span>
            </div>
            <span class="media-cta">
              Read full case study
              <span class="arrow"><Icon name="arrow-right" /></span>
            </span>
          </div>
        </a>

        <div class="media-row">
          <div class="media-row-media">
            <img src="/images/eju.png" alt="European Judo Union website redesign" />
            <span class="media-badge">Coming soon</span>
          </div>
          <div class="media-row-body">
            <h3>European Judo Union Redesign</h3>
            <p class="media-desc">
              I designed the European Judo Union site to handle huge traffic for live Judo competitions
              across multiple simultaneous tatamis.
            </p>
          </div>
        </div>

        <div class="media-row">
          <div class="media-row-media">
            <img src="/images/sweeperz.png" alt="Sweeperz mobile app UI design" />
            <span class="media-badge">Coming soon</span>
          </div>
          <div class="media-row-body">
            <h3>Sweeperz Mobile App Design</h3>
            <p class="media-desc">
              I designed the Sweeperz App to help Degens get that piece of merch they've been eyeing,
              with a gamified mobile experience.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- JOURNAL -->
  <section id="journal" class="journal-section">
    <div class="folio-container">
      <header class="section-head">
        <h2>UX journal</h2>
        <p class="section-lede">Short notes on design, research, and where AI actually helps.</p>
      </header>

      <div class="journal-list">
        <a class="journal-row" href="https://www.linkedin.com/posts/oussamabougnouch_ux-productdesign-uxstrategy-activity-7305510620815056896-or-l?utm_source=share&utm_medium=member_desktop&rcm=ACoAABmVliYBI76igzSDPC6kVqh9_TsYbz-KXIA" target="_blank">
          <p class="journal-index">01</p>
          <div>
            <h4>Why Good UX Can Still Fail</h4>
            <p>A flawless UX doesn't always mean success. If UX research focuses only on user...</p>
          </div>
          <span class="arrow"><Icon name="arrow-right" /></span>
        </a>
        <a class="journal-row" href="https://www.linkedin.com/posts/oussamabougnouch_uxdesign-productdesign-wireframing-activity-7305165685725249537-Bsen?utm_source=share&utm_medium=member_desktop&rcm=ACoAABmVliYBI76igzSDPC6kVqh9_TsYbz-KXIA" target="_blank">
          <p class="journal-index">02</p>
          <div>
            <h4>Figma is Not Your Best UX Tool. This is</h4>
            <p>In the rush to master Figma, many designers skip the most important...</p>
          </div>
          <span class="arrow"><Icon name="arrow-right" /></span>
        </a>
        <a class="journal-row" href="https://www.linkedin.com/posts/oussamabougnouch_legendary-product-design-mclaren-p1-by-activity-7299710531001565184-KPPY?utm_source=share&utm_medium=member_desktop&rcm=ACoAABmVliYBI76igzSDPC6kVqh9_TsYbz-KXIA" target="_blank">
          <p class="journal-index">03</p>
          <div>
            <h4>#1 Legendary Product Design</h4>
            <p>Frank Stephenson is one of the most influential car designers of our time....</p>
          </div>
          <span class="arrow"><Icon name="arrow-right" /></span>
        </a>
        <a class="journal-row" href="https://www.linkedin.com/feed/update/urn:li:activity:7295340251814739969/" target="_blank">
          <p class="journal-index">04</p>
          <div>
            <h4>AI is coming for your jobs... but</h4>
            <p>Imagine a world where 60% of developers, IT professionals...</p>
          </div>
          <span class="arrow"><Icon name="arrow-right" /></span>
        </a>
        <a class="journal-row" href="https://www.linkedin.com/feed/update/urn:li:activity:7306070333373988864?utm_source=share&utm_medium=member_desktop&rcm=ACoAABmVliYBI76igzSDPC6kVqh9_TsYbz-KXIA" target="_blank">
          <p class="journal-index">05</p>
          <div>
            <h4>Why Empathy Maps Are Useless (And What to...)</h4>
            <p>Empathy maps are everywhere in UX, but let's be honest they don't...</p>
          </div>
          <span class="arrow"><Icon name="arrow-right" /></span>
        </a>
        <a class="journal-row" href="https://www.linkedin.com/posts/oussamabougnouch_design-failures-we-can-learn-from-the-virtual-activity-7303916045247864832-rUi-?utm_source=share&utm_medium=member_desktop&rcm=ACoAABmVliYBI76igzSDPC6kVqh9_TsYbz-KXIA" target="_blank">
          <p class="journal-index">06</p>
          <div>
            <h4>Design Failures We Can Learn FROM</h4>
            <p>Nintendo tried to revolutionize gaming with portable 3D...</p>
          </div>
          <span class="arrow"><Icon name="arrow-right" /></span>
        </a>
      </div>
    </div>
  </section>

  <Footer />

</Layout>
