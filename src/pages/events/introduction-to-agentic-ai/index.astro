---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SlideDeck from '../../../components/SlideDeck.astro';
import PhotoGallery from '../../../components/PhotoGallery.astro';

const BASE = '/events/introduction-to-agentic-ai';

/* Slide images generated by scripts/build-event-slides.mjs from the deck PDF.
   Titles are the heading of each slide — they caption the frame and give the
   images real alt text. */
const slideTitles = [
  'Beneath the Skull of AI: Giving the Brain a Body (Part 2)',
  'Quick Recap of Part 1',
  "What You'll Learn Today",
  'From LLM to Agent',
  "What's the Difference?",
  'The Loop',
  'Tools: How The LLM Gets Hands',
  'Why Agents Fail',
  'The Agent That Lied to Me',
  'The Golden Rule: Trust, but Verify',
  'The Building Blocks of an AI Agent',
  'The 4 Parts of Every Agent',
  'The Personality File SOUL.md',
  'The Skills SKILL.md',
  'Meet Hermes',
  'Hermes: A Complete AI Agent',
  'Hermes: How it works',
  'Hermes Skills vs Tools',
  'Hermes Skills vs Tools — the full list',
  'Watch Hermes Work',
];

/* Generated by scripts/optimize-event-photos.mjs — slugs and dimensions match
   photos-source/events/introduction-to-agentic-ai/manifest.json. */
const photos = [
  {
    slug: 'group-photo',
    w: 1280,
    h: 960,
    caption: 'Everyone who showed up',
    alt: 'Group photo of all workshop attendees in front of the Hermes Agent slide at the end of the session',
  },
  {
    slug: 'setup',
    w: 960,
    h: 1280,
    caption: 'Setting up before the room filled',
    alt: 'Oussama preparing the workshop at a desk with a laptop, keyboard and mouse before attendees arrive',
  },
  {
    slug: 'whats-the-difference',
    w: 720,
    h: 1280,
    caption: "What's the difference?",
    alt: 'Oussama presenting beside a screen comparing LLMs and AI agents point by point',
  },
  {
    slug: 'explaining-agents',
    w: 720,
    h: 1280,
    caption: 'Explaining what makes an agent an agent',
    alt: 'Oussama speaking mid-explanation to seated attendees, an open laptop in the foreground',
  },
  {
    slug: 'full-room',
    w: 720,
    h: 1280,
    caption: 'Slides up, room full',
    alt: 'Wide view of the workshop room from the back, attendees seated around tables facing the projector screen',
  },
  {
    slug: 'live-presentation',
    w: 720,
    h: 1280,
    caption: 'Live presentation',
    alt: 'Oussama presenting to the room during the live walkthrough',
  },
  {
    slug: 'walkthrough',
    w: 720,
    h: 1280,
    caption: 'Walking through the flow',
    alt: 'Oussama standing between the tables walking attendees through an agent workflow',
  },
  {
    slug: 'hermes-architecture',
    w: 720,
    h: 1280,
    caption: 'Hermes architecture',
    alt: 'Slide showing how the Hermes agent works, presented to the room',
  },
  {
    slug: 'attendees',
    w: 720,
    h: 1280,
    caption: 'Attendees',
    alt: 'Side view of attendees seated at long wooden tables listening, a mural on the far wall',
  },
  {
    slug: 'audience-engagement',
    w: 720,
    h: 1280,
    caption: 'Audience engagement',
    alt: 'Attendees following along during the workshop',
  },
  {
    slug: 'open-floor',
    w: 720,
    h: 1280,
    caption: 'Opening the floor',
    alt: 'Oussama standing with arms crossed listening to the room during an open discussion',
  },
  {
    slug: 'interactive-session',
    w: 720,
    h: 1280,
    caption: 'Interactive session',
    alt: 'Attendees taking part in the interactive portion of the workshop',
  },
  {
    slug: 'qa-session',
    w: 720,
    h: 1280,
    caption: 'Taking questions',
    alt: 'Oussama gesturing toward an attendee while answering a question during the Q&A',
  },
  {
    slug: 'discussion',
    w: 720,
    h: 1280,
    caption: 'Group discussion',
    alt: 'Oussama facing the room during a group discussion, attendees seated at tables around him',
  },
  {
    slug: 'llm-vs-agents',
    w: 720,
    h: 1280,
    caption: 'LLM vs agents',
    alt: 'Slide contrasting what a traditional LLM can do against what an agent can do',
  },
  {
    slug: 'from-the-back',
    w: 720,
    h: 1280,
    caption: 'From the back of the room',
    alt: 'View over attendees shoulders toward the presenter and projector screen',
  },
  {
    slug: 'after-session',
    w: 720,
    h: 1280,
    caption: 'Conversations after the session',
    alt: 'Small group of attendees talking with Oussama around a table after the workshop ended',
  },
  {
    slug: 'quick-recap',
    w: 720,
    h: 1280,
    caption: 'Quick recap',
    alt: 'Recap slide summarising the key takeaways of the workshop',
  },
  {
    slug: 'venue',
    w: 720,
    h: 1280,
    caption: 'The venue',
    alt: 'The co-working space that hosted the workshop',
  },
];
---

<Layout title="Introduction to Agentic AI | Oussama Bougnouch" description="Workshop gallery on AI agents and LLMs">

  <Header />

  <PageHeader
    eyebrow="Workshop · September 2026"
    title="Introduction to Agentic AI"
    back={{ href: '/events', label: 'Back to events' }}>
    <p class="page-lede">
      A hands-on workshop exploring the difference between traditional LLMs and AI agents,
      covering practical applications and real-world implementations.
    </p>
  </PageHeader>

  <section class="event-slides">
    <div class="folio-container">
      <header class="section-head">
        <h2>The deck</h2>
        <p class="section-lede">All {slideTitles.length} slides from the session, in order.</p>
      </header>

      <SlideDeck base={`${BASE}/slides`} titles={slideTitles} label="Introduction to Agentic AI — workshop slides" />
    </div>
  </section>

  <section class="event-gallery">
    <div class="folio-container">
      <header class="section-head">
        <h2>Photos</h2>
        <p class="section-lede">From the room on the day.</p>
      </header>

      <PhotoGallery base={BASE} photos={photos} />
    </div>
  </section>

  <Footer />

</Layout>

<style>
  .event-slides {
    padding: 64px 0 0;
  }

  .event-gallery {
    padding: 72px 0 90px;
  }

  @media (max-width: 767px) {
    .event-slides { padding: 44px 0 0; }
    .event-gallery { padding: 52px 0 56px; }
  }


</style>
