---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SlideDeck from '../../../components/SlideDeck.astro';
import PhotoGallery from '../../../components/PhotoGallery.astro';

const BASE = '/events/beneath-the-skull-of-ai';

/* Slide images generated by:
     node scripts/build-event-slides.mjs beneath-the-skull-of-ai
   Titles are each slide's own heading — they caption the frame and give the
   slide images real alt text. */
const slideTitles = [
  'Beneath the Skull of AI: How It Actually Works (Part 1)',
  'The Great AI Shakeout',
  "Let's get started",
  'The Crossroads: cloud AI or local AI',
  'The Model (LLM)',
  'Choosing your model',
  'Large models',
  'Medium models',
  'Small models',
  'Mixture of Experts (MoE)',
  'Estimated sizes of popular AI models',
  'The Engine',
  'The Engine (the seat)',
  'llama.cpp and Ollama',
  'Hardware prerequisites',
  'RAM vs vRAM',
  'Unified Memory Architecture (UMA)',
  'The RAM allocation reality check',
  'The weight of the raw brains',
  'The GPU muscle',
  'The bandwidth',
  'The AI speed formula',
  'Tokens/s running Qwen 3.6 35B A3B',
  'Tokens/s — unquantized, the answer',
  'Tokens/s — quantized, the answer',
  'The Quantization',
  'The mathematical shrink ray',
  'How precision scaling works',
  'Qwen3.6-35B-A3B quantized versions',
  'Estimated precision loss per quantization',
  'The Context',
  'Understanding conversation overhead',
  'Choosing the right context size',
  'Context compression',
  'Context quantization',
  "What's coming in Part 2",
];

/* Generated by:
     node scripts/optimize-event-photos.mjs beneath-the-skull-of-ai
   Slugs and dimensions match photos-source/events/beneath-the-skull-of-ai/manifest.json. */
const photos = [
  {
    slug: 'opening-the-room',
    w: 720,
    h: 1280,
    caption: 'Opening the room',
    alt: 'Oussama standing and gesturing while addressing attendees, a laptop set up on the table behind him',
  },
  {
    slug: 'medium-models',
    w: 720,
    h: 1280,
    caption: 'Which models fit on a laptop',
    alt: 'Oussama standing beside the screen showing the Medium models comparison table of Gemma and Qwen releases',
  },
  {
    slug: 'mixture-of-experts',
    w: 720,
    h: 1280,
    caption: 'Mixture of Experts',
    alt: 'Oussama presenting in front of the Mixture of Experts slide, explaining how a router picks which specialists answer',
  },
  {
    slug: 'the-shrink-ray',
    w: 720,
    h: 1280,
    caption: 'The mathematical shrink ray',
    alt: 'Oussama mid-explanation beside the Mathematical Shrink Ray slide introducing quantization',
  },
  {
    slug: 'precision-scaling',
    w: 720,
    h: 1280,
    caption: 'Finding the sweet spot',
    alt: 'Oussama pointing at the How Precision Scaling Works slide, at the Q5 and Q4 sweet-spot bullet',
  },
  {
    slug: 'the-destruction-zone',
    w: 720,
    h: 1280,
    caption: 'Down to the destruction zone',
    alt: 'Oussama with arm extended toward the precision-scaling illustration showing q8 through q1 shrinking in size',
  },
  {
    slug: 'quantized-versions',
    w: 720,
    h: 1280,
    caption: '53 GB of vRAM saved',
    alt: 'Oussama pointing at the quantized-versions table for Qwen3.6-35B-A3B, comparing the 16-bit build against a 3-bit one',
  },
  {
    slug: 'kv-cache',
    w: 720,
    h: 1280,
    caption: 'The KV cache',
    alt: 'Oussama pointing at the Understanding Conversation Overhead slide explaining how the KV cache grows with the conversation',
  },
  {
    slug: 'open-discussion',
    w: 720,
    h: 1280,
    caption: 'Questions from the floor',
    alt: 'An attendee seated in the co-working space gesturing while making a point during the discussion',
  },
];
---

<Layout
  title="Beneath the Skull of AI | Oussama Bougnouch"
  description="Workshop on how AI actually works under the hood: picking a model, the engine that runs it, hardware limits, quantization and context.">

  <Header />

  <PageHeader
    eyebrow="Workshop · Part 1"
    title="Beneath the Skull of AI"
    back={{ href: '/events', label: 'Back to events' }}>
    <p class="page-lede">
      How an LLM actually works under the hood — choosing a model, the engine that runs it,
      the hardware that limits it, and the quantization and context tricks that make a large
      model fit on a laptop.
    </p>
  </PageHeader>

  <section class="event-slides">
    <div class="folio-container">
      <header class="section-head">
        <h2>The deck</h2>
        <p class="section-lede">All {slideTitles.length} slides from the session, in order.</p>
      </header>

      <SlideDeck base={`${BASE}/slides`} titles={slideTitles} label="Beneath the Skull of AI — workshop slides" />
    </div>
  </section>

  <section class="event-gallery">
    <div class="folio-container">
      <header class="section-head">
        <h2>Photos</h2>
        <p class="section-lede">From the room on the day.</p>
      </header>

      <PhotoGallery base={BASE} photos={photos} />
    </div>
  </section>

  <Footer />

</Layout>

<style>
  .event-slides {
    padding: 64px 0 0;
  }

  .event-gallery {
    padding: 72px 0 90px;
  }

  @media (max-width: 767px) {
    .event-slides { padding: 44px 0 0; }
    .event-gallery { padding: 52px 0 56px; }
  }
</style>
