---
import Icon from './Icon.astro';

interface Props {
  /** Category this page belongs to — "Case study", "Workshop", "Events". */
  eyebrow?: string;
  title: string;
  /** Renders the shared back link above the eyebrow. */
  back?: { href: string; label: string };
  /** The home page's full-screen intro: avatar name row, large lede. */
  intro?: boolean;
}

const { eyebrow, title, back, intro } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<header class:list={['page-header', back && 'has-back', hasMedia && 'has-media', intro && 'is-intro']}>
  <!-- The engraving on its own layer, so the parallax in motion.ts moves it
       with a GPU transform instead of repainting the cover every frame. -->
  <div class="page-header-bg" aria-hidden="true"></div>
  <div class="folio-container">
    <div class="page-header-grid">
      <div class="page-header-text">
        {back && (
          <a class="back-link" href={back.href}>
            <Icon name="arrow-left" />
            {back.label}
          </a>
        )}
        {eyebrow && <p class="micro-label">{eyebrow}</p>}
        {intro ? (
          /* Home intro: photo beside the title and pitch, in one outlined card.
             A real <img> with alt text, so the photo is indexable. */
          <div class="intro-card">
            <img class="intro-avatar" src="/images/avatar.webp" alt="Oussama Bougnouch" width="112" height="112" fetchpriority="high" decoding="async" />
            <div class="intro-card-text">
              <h1>{title}</h1>
              <slot name="lede" />
            </div>
          </div>
        ) : (
          <h1>{title}</h1>
        )}
        <slot />
        {intro && (
          /* Drifting clouds along the bottom of the intro (see .cloud-drift). */
          <div class="cloud-drift" aria-hidden="true"><span class="cloud-layer cloud-far"></span><span class="cloud-layer cloud-near"></span></div>
        )}
      </div>

      {hasMedia && (
        <div class="page-header-media">
          <slot name="media" />
        </div>
      )}
    </div>
  </div>
</header>

