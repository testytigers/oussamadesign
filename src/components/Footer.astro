---
import Icon from './Icon.astro';
---

<footer class="site-footer" id="contact">
  <div class="folio-container">
    <div class="footer-cta">
      <div class="footer-cta-text">
        <p class="micro-label">Get in touch</p>
        <h2>Have a product that deserves better UX?</h2>
      </div>
      <div class="footer-actions">
        <a class="btn btn-primary" href="mailto:musamathemes@gmail.com">
          Start a conversation <Icon name="arrow-right" />
        </a>
        <a class="btn btn-ghost" href="/resume.pdf" target="_blank">
          Download resume <Icon name="external" />
        </a>
      </div>
    </div>

    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <div class="footer-wordmark">
          <img src="/images/logo-photo.jpg" alt="" />
          Oussama Bougnouch
        </div>
        <p>Sr UX Designer & AI System Builder, designing products people actually finish using.</p>
      </div>

      <div class="footer-col">
        <p class="micro-label">Navigate</p>
        <a href="/#work">Work</a>
        <a href="/events">Events</a>
        <a href="/#journal">Journal</a>
      </div>

      <div class="footer-col">
        <p class="micro-label">Elsewhere</p>
        <a href="https://www.linkedin.com/in/oussamabougnouch/" target="_blank">LinkedIn <Icon name="external" /></a>
        <a href="mailto:musamathemes@gmail.com">Email <Icon name="external" /></a>
        <a href="/resume.pdf" target="_blank">Resume <Icon name="external" /></a>
      </div>

      <div class="footer-col">
        <p class="micro-label">Based in</p>
        <p>Rabat, Morocco</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Oussama Bougnouch. All rights reserved.</p>

      <div class="footer-socials">
        <a href="https://www.linkedin.com/in/oussamabougnouch/" target="_blank" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
        </a>
        <a href="mailto:musamathemes@gmail.com" aria-label="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        </a>
        <a href="tel:+212698996201" aria-label="Phone">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
