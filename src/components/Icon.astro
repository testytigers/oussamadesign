---
interface Props {
  name: 'arrow-right' | 'arrow-left' | 'external' | 'close';
}

const { name } = Astro.props;

const paths = {
  'arrow-right': 'M5 12h13M12 5l7 7-7 7',
  'arrow-left': 'M19 12H6M12 19l-7-7 7-7',
  'external': 'M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4',
  'close': 'M6 6l12 12M18 6 6 18',
};
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
><path d={paths[name]} /></svg>
