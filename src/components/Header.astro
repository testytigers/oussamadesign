---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { defaultLang, localizePath, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  /** Unprefixed path of the current page, so the switcher stays on this page. */
  path?: string;
}
const { lang = defaultLang, path = '/' } = Astro.props;
const d = t(lang);
const home = localizePath(lang, '/');
---

<header class="site-header">
  <!-- The old OB wordmark, rebuilt for search: the monogram is inline SVG and
       the name is live text, so every page links home with the anchor text
       "Oussama Bougnouch". No <h1> (each page's own title keeps that) and no
       text hidden off-screen. Two spans with a real space between them, so the
       link text reads "Oussama Bougnouch" and never "OussamaBougnouch". -->
  <a href={home} class="logo-mark" aria-current={path === '/' ? 'page' : undefined}>
    <Logo class="logo-monogram" />
    <span class="logo-name"><span>Oussama</span> <span>Bougnouch</span></span>
  </a>

  <button type="button" class="nav-toggle" aria-label={d.a11y.toggleNav} aria-expanded="false" aria-controls="nav-links">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="header-right">
    <nav class="nav-links" id="nav-links">
      <a href={`${home}#work`}>{d.nav.work}</a>
      <a href={localizePath(lang, '/events')}>{d.nav.events}</a>
      <a href="/resume.pdf" target="_blank">{d.nav.resume} <Icon name="external" /></a>
    </nav>

    <div class="header-icons">
      <LangSwitch lang={lang} path={path} />
      <a class="icon-btn" href="https://www.linkedin.com/in/oussamabougnouch/" target="_blank" aria-label={d.a11y.linkedin}>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
