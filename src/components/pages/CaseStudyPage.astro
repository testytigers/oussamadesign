---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import { defaultLang, localizePath, t, type Lang } from '../../i18n';
import { caseStudyGraph } from '../../seo/schema';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const c = t(lang).caseStudy;
const d = t(lang);
const PATH = '/wiggli-calendar-ux-case-study/';
const IMG = '/images/work';
const OG = `/images/og/case-study-${lang}.jpg`;

const schema = caseStudyGraph(
  { lang, path: PATH, title: c.title, description: c.metaDescription, image: OG },
  {
    topics: ['UX Design', 'Recruitment Software', 'Calendar Scheduling', 'B2B SaaS', 'Design Systems'],
    client: 'Wiggli',
    homeName: d.nav.work,
  }
);
---

<Layout
  title={c.metaTitle}
  description={c.metaDescription}
  image={OG}
  lang={lang}
  path={PATH}
  ogType="article"
  schema={schema}>

  <Header lang={lang} path={PATH} />

  <PageHeader
    eyebrow={c.eyebrow}
    title={c.title}
    back={{ href: localizePath(lang, '/#work'), label: d.common.backToWork }}>
    <p class="page-lede">{c.lede}</p>
    <div class="media-chips">
      {c.chips.map((chip) => <span class="chip">{chip}</span>)}
    </div>
  </PageHeader>

  <article>
    <div class="folio-container">
      <figure class="cs-figure wide">
        <img src={`${IMG}/cal-view.png`} alt={c.figures.calView} />
      </figure>
    </div>

    <!-- DISCOVERY -->
    <section class="cs-section">
      <div class="cs-body">
        <header class="section-head">
          <p class="micro-label">{c.discovery.label}</p>
          <h2 set:html={c.discovery.heading} />
        </header>
        <p>{c.discovery.p1}</p>
        <p>{c.discovery.p2}</p>

        <h3 set:html={c.discovery.researchHeading} />
        <ul>{c.discovery.research.map((item) => <li set:html={item} />)}</ul>
      </div>

      <div class="folio-container">
        <figure class="cs-figure">
          <img src={`${IMG}/journey-map.png`} alt={c.figures.journeyMap} />
        </figure>
      </div>

      <div class="cs-body">
        <h3>{c.discovery.problemsHeading}</h3>
      </div>

      <div class="folio-container">
        <figure class="cs-figure">
          <img src={`${IMG}/problem.png`} alt={c.figures.problem} />
        </figure>
      </div>

      <div class="cs-body">
        <ul>{c.discovery.problems.map((item) => <li set:html={item} />)}</ul>
      </div>

      <div class="folio-container">
        <figure class="cs-figure">
          <img src={`${IMG}/old-experience.gif`} alt={c.figures.oldExperience} />
          <figcaption>{c.figures.oldExperienceCaption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- SOLUTION -->
    <section class="cs-section">
      <div class="cs-body">
        <header class="section-head">
          <p class="micro-label">{c.solution.label}</p>
          <h2 set:html={c.solution.heading} />
        </header>
        <p>{c.solution.p1}</p>
      </div>

      <div class="folio-container">
        <figure class="cs-figure">
          <img src={`${IMG}/user-flow.png`} alt={c.figures.userFlow} />
        </figure>
      </div>

      <div class="cs-body">
        <h3>{c.solution.groupsHeading}</h3>
        <p>{c.solution.groupsP}</p>
      </div>

      <div class="folio-container">
        <figure class="cs-figure">
          <img src={`${IMG}/collaborative-groups.png`} alt={c.figures.collaborativeGroups} />
        </figure>
      </div>

      <div class="cs-body">
        <h3>{c.solution.engineHeading}</h3>
        <p>{c.solution.engineP}</p>
        <ul>{c.solution.engine.map((item) => <li set:html={item} />)}</ul>
      </div>

      <div class="folio-container">
        <figure class="cs-figure">
          <img src={`${IMG}/find-best.png`} alt={c.figures.findBest} />
        </figure>
      </div>

      <div class="cs-body">
        <h3>{c.solution.archHeading}</h3>
        <p>{c.solution.archP}</p>
        <ul>{c.solution.arch.map((item) => <li set:html={item} />)}</ul>
      </div>

      <div class="folio-container">
        <figure class="cs-figure">
          <img src={`${IMG}/calendar-views.png`} alt={c.figures.calendarViews} />
        </figure>
      </div>

      <div class="cs-body">
        <h3 set:html={c.solution.syncHeading} />
        <p>{c.solution.syncP}</p>
      </div>

      <div class="folio-container">
        <figure class="cs-figure">
          <img src={`${IMG}/calendar-settings.png`} alt={c.figures.calendarSettings} />
        </figure>
      </div>

      <div class="cs-body">
        <h3>{c.solution.notifHeading}</h3>
        <p>{c.solution.notifP}</p>
      </div>
    </section>

    <!-- ADOPTION -->
    <section class="cs-section">
      <div class="cs-body">
        <header class="section-head">
          <p class="micro-label">{c.adoption.label}</p>
          <h2 set:html={c.adoption.heading} />
        </header>
        <ul>{c.adoption.items.map((item) => <li set:html={item} />)}</ul>
      </div>
    </section>

    <!-- RESULTS -->
    <section class="cs-section">
      <div class="cs-body">
        <header class="section-head">
          <p class="micro-label">{c.results.label}</p>
          <h2 set:html={c.results.heading} />
        </header>
        <p>{c.results.p1}</p>
      </div>

      <div class="folio-container">
        <div class="table-scroll">
          <table class="cs-table">
            <thead>
              <tr>{c.results.tableHeaders.map((h) => <th>{h}</th>)}</tr>
            </thead>
            <tbody>
              {c.results.rows.map((row) => (
                <tr>
                  <td>{row.metric}</td>
                  <td class="num">{row.before}</td>
                  <td class="num">{row.after}</td>
                  <td>{row.impact}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="cs-body">
        <h3>{c.results.measuresHeading}</h3>
        <ul>{c.results.measures.map((item) => <li set:html={item} />)}</ul>

        <h3>{c.results.iterationHeading}</h3>
        <p>{c.results.iterationP}</p>
      </div>

      <div class="folio-container">
        <figure class="cs-figure">
          <img src={`${IMG}/schedule.png`} alt={c.figures.schedule} />
        </figure>
      </div>
    </section>

    <!-- CONCLUSION -->
    <section class="cs-section cs-conclusion">
      <div class="cs-body">
        <header class="section-head">
          <p class="micro-label">{c.conclusion.label}</p>
          <h2 set:html={c.conclusion.heading} />
        </header>
        <p>{c.conclusion.p1}</p>
        <a href={localizePath(lang, '/#work')} class="back-link"><Icon name="arrow-left" /> {d.common.backToWork}</a>
      </div>
    </section>
  </article>

  <Footer lang={lang} />
</Layout>

<style>
  /* Reading column */
  .cs-body {
    width: 760px;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .cs-body { padding: 0 40px; }
  }

  /* This must stay a class rule, not `article section` — Astro scopes every
     compound, so `article[cid] section[cid]` (0,2,2) would outrank
     `.cs-section[cid]` (0,2,0) and flatten the padding to whatever it set. */
  .cs-section {
    padding: 72px 0;
    border-top: 1px solid var(--border);
  }

  /* The hero figure above already carries 34px of its own margin. */
  .cs-section:first-of-type {
    border-top: none;
    padding-top: 30px;
  }

  /* The section padding owns the rhythm around each divider; a trailing
     paragraph, list or figure margin would stack on top of it unevenly. */
  .cs-section > :last-child > :last-child,
  .cs-section > :last-child > ul:last-child > li:last-child {
    margin-bottom: 0;
  }

  /* Same section-title typography as the home page, tighter gap to the prose. */
  .cs-body .section-head {
    margin-bottom: 24px;
  }

  .cs-body h3 {
    font-size: 1.2rem;
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .cs-body p {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 180%;
  }

  .cs-body ul {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
  }

  .cs-body li {
    position: relative;
    padding-left: 22px;
    color: var(--text-muted);
    line-height: 180%;
    margin-bottom: 12px;
  }

  .cs-body li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 13px;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }

  .cs-body strong {
    color: var(--text);
    font-weight: 600;
  }

  /* Figures */
  .cs-figure {
    margin: 34px 0;
  }

  .cs-figure img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border: 1px solid var(--border-strong);
    border-radius: 20px;
    background: var(--card-bg);
  }

  .cs-figure.wide {
    margin-top: 56px;
  }

  .cs-figure figcaption {
    margin-top: 12px;
    color: var(--text-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  /* Results table */
  .table-scroll {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--card-bg);
  }

  .cs-table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
  }

  .cs-table th {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: left;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }

  .cs-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.93rem;
  }

  .cs-table td:first-child {
    color: var(--text);
    font-weight: 500;
  }

  .cs-table td.num {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.88rem;
    color: var(--text);
  }

  .cs-table tbody tr:last-child td {
    border-bottom: none;
  }

  .cs-conclusion .back-link {
    margin: 30px 0 0;
  }

  @media (max-width: 767px) {
    .cs-section { padding: 48px 0; }
    .cs-section:first-of-type { padding-top: 20px; }
  }
</style>
